{
  "name": "frontendlab",
  "private": true,
  "type": "module",
  "description": "フレームワーク非依存のフロントエンド・ツールチェーン実験。root に依存を残さない（ここで閉じる）。",
  "scripts": {
    "exp1": "node measure.mjs --exp transpiler-orders",
    "exp2": "node measure.mjs --exp bundle-orders",
    "exp3": "node measure.mjs --exp dependency-cost",
    "exp4": "node measure.mjs --exp minify-orders",
    "all": "npm run exp1 && npm run exp2 && npm run exp3 && npm run exp4",
    "gate": "node plugins/budget-gate.mjs --budget budget.json",
    "build": "node build.mjs",
    "dev": "node dev.mjs",
    "new": "node create.mjs",
    "prerender": "node prerender.mjs",
    "check": "node check.mjs",
    "diagnose": "node tools/diagnose.mjs",
    "doctor": "node tools/doctor.mjs",
    "manifest": "node tools/manifest.mjs",
    "fmt": "node format.mjs --check",
    "lsp": "node tools/lsp.mjs",
    "gen": "node tools/gen-recipe-vocab.mjs",
    "bench": "node bench/build-bench.mjs && node bench/run-bench.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "node check.mjs && node format.mjs --check && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@babel/core": "8.0.5",
    "@babel/parser": "8.0.5",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@swc/core": "1.16.2",
    "@vue/compiler-dom": "3.5.42",
    "esbuild": "0.28.2",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "oxc-minify": "0.149.0",
    "oxc-transform": "0.149.0",
    "sass": "1.104.0",
    "vue": "3.5.42"
  }
}
