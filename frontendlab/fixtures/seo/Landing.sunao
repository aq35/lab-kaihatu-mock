<template>
  <main class="lp">
    <header class="hero">
      <p class="eyebrow">個人用途のフロントエンド・ツールチェーン</p>
      <h1 class="h1">sunao — AI が好きそうなコンパイラ</h1>
      <p class="lead">
        宣言的・fail-closed・決定論・小さい。Vue 風の SFC を build 時に決定論的な JS へコンパイルし、
        極小のリアクティブ runtime で動かす。未知の書き方は静かに壊れず、コンパイルエラーになる。
      </p>
      <div class="cta">
        <a class="btn primary" href="#features">特徴を見る</a>
        <a class="btn" href="#seo">SEO について</a>
      </div>
    </header>

    <section id="features" class="section">
      <h2 class="h2">特徴</h2>
      <ul class="cards">
        <li class="feat" v-for="f in features">
          <h3 class="ft">{{ f.title }}</h3>
          <p class="fd">{{ f.body }}</p>
        </li>
      </ul>
    </section>

    <section id="seo" class="section">
      <h2 class="h2">なぜ SEO に強いか</h2>
      <p class="p">
        このページ自体が sunao で書かれ、ビルド時に <strong>実 HTML へ prerender</strong> されている。
        つまりクローラは JavaScript を実行しなくても、上の見出し・本文・特徴リストをそのまま読める。
        対話が必要な部分だけを client で hydrate するので、初期 HTML は常に「中身入り」になる。
      </p>
      <div class="counter" data-hydrate="counter">
        <p class="ctext">これは hydrate される対話要素。サーバHTMLでは <b>{{ count() }}</b> と描画され、
          読み込み後はボタンが効く。</p>
        <div class="crow">
          <button class="btn" @click="dec()">−</button>
          <output class="cval">{{ count() }}</output>
          <button class="btn primary" @click="inc()">＋</button>
        </div>
      </div>
    </section>

    <footer class="foot">
      <p>© 2026 sunao lab — フレームワークを作り直さず、入力の型・fail-closed・決定論・低 context だけを足す。</p>
    </footer>
  </main>
</template>

<script>
export default {
  meta: {
    title: 'sunao — AI が好きそうなコンパイラ',
    description: '宣言的・fail-closed・決定論・小さい。Vue 風 SFC を決定論的な JS へコンパイルし極小 runtime で動かす、個人用途のフロントエンド・ツールチェーン。',
    canonical: 'https://example.com/sunao',
    image: 'https://example.com/og.png',
  },
  setup() {
    const count = signal(0);
    const inc = () => count.update((v) => v + 1);
    const dec = () => count.update((v) => v - 1);
    const features = [
      { title: 'fail-closed コンパイラ', body: '未宣言参照・未知ディレクティブ・型不一致を build 時に停止。診断は「もしかして」提案つき。' },
      { title: '細粒度リアクティブ', body: 'VDOM 無し。signal を読んだ箇所だけ更新。静的な部品は runtime を引かず純 HTML。' },
      { title: 'SSG prerender', body: 'ビルド時に実 HTML を吐き、対話部分だけ hydrate。コンテンツは常に初期 HTML に入る。' },
      { title: '決定論と予算', body: '2 回ビルドで sha 一致・bytes 予算・クロス契約を factory が一括検査。壊れた部品を増やせない。' },
    ];
    return { count, inc, dec, features };
  },
};
</script>

