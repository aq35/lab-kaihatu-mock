  font-family: system-ui, "Hiragino Sans", "Noto Sans JP", sans-serif; color: #1a2233; line-height: 1.7; }
.eyebrow { text-transform: uppercase; letter-spacing: .12em; font-size: .74rem; font-weight: 700; color: #5b6b8c; margin: 0 0 .6rem; }
