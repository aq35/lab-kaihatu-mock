.cta { display: flex; gap: .7rem; flex-wrap: wrap; }
.btn { display: inline-flex; align-items: center; padding: .6rem 1.1rem; border-radius: 11px; border: 1px solid #c7d0e0;
  background: #fff; color: #1a2233; font: inherit; font-weight: 600; cursor: pointer; text-decoration: none; }
.btn.primary { background: #2f5fe0; border-color: #2f5fe0; color: #fff; }
.section { margin-top: clamp(2.5rem, 6vw, 4rem); }
.h2 { font-size: 1.6rem; letter-spacing: -.01em; margin: 0 0 1.2rem; }
.cards { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); }
.feat { border: 1px solid #e2e8f4; border-radius: 15px; padding: 1.2rem; background: #fbfcff; }
.ft { margin: 0 0 .4rem; font-size: 1.08rem; }
.fd { margin: 0; color: #445; font-size: .95rem; }
.p { font-size: 1.05rem; color: #33415c; max-width: 44rem; }
.counter { margin-top: 1.4rem; border: 1px dashed #c7d0e0; border-radius: 15px; padding: 1.2rem; background: #f6f9ff; }
.ctext { margin: 0 0 .8rem; color: #445; }
.crow { display: flex; align-items: center; gap: .8rem; }
.cval { min-width: 3rem; text-align: center; font-size: 1.6rem; font-weight: 700; font-variant-numeric: tabular-nums; }
