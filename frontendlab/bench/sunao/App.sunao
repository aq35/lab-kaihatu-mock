<template>
  <table class="t"><tbody>
    <tr v-for="row in rows()" :key="row.id" :class="row.id === selected() ? 'selected' : ''">
      <td class="id">{{ row.id }}</td>
      <td class="lbl"><a>{{ row.label() }}</a></td>
    </tr>
  </tbody></table>
</template>
<script>
const A = ['pretty','large','fancy','silent','warm','quiet','clean','odd','cheap','red','green','blue'];
const N = ['table','chair','house','car','book','road','pony','mouse','keyboard','panel'];
let seed = 1;
const rnd = (m) => (seed = (seed * 1103515245 + 12345) & 0x7fffffff) % m; // 決定論的
export default {
  name: 'Bench',
  setup() {
    const rows = signal([]);
    const selected = signal(-1);
    let nextId = 1;
    const build = (n) => {
      const a = new Array(n);
      for (let i = 0; i < n; i++) a[i] = { id: nextId++, label: signal(`${A[rnd(A.length)]} ${N[rnd(N.length)]}`) };
      return a;
    };
    return {
      rows, selected,
      create1k: () => rows.set(build(1000)),
      create10k: () => rows.set(build(10000)),
      append1k: () => rows.set([...rows(), ...build(1000)]),
      updateEvery10: () => { const a = rows(); for (let i = 0; i < a.length; i += 10) a[i].label.update((s) => s + ' !!!'); },
      swap: () => { const a = [...rows()]; if (a.length > 3) { const t = a[1]; a[1] = a[a.length - 2]; a[a.length - 2] = t; rows.set(a); } },
      selectRandom: () => { const a = rows(); if (a.length) selected.set(a[rnd(a.length)].id); },
      removeFirst: () => { const a = [...rows()]; a.shift(); rows.set(a); },
      clear: () => { rows.set([]); selected.set(-1); },
    };
  },
};
</script>
