<template>
  <div class="wiki">
    <header class="top">
      <button class="brand" @click="pick(articles[0].id)">📖 __APP_NAME__</button>
      <nav class="tabs">
        <button class="tab" v-for="a in articles" :key="a.id" :class="a.id === cur().id ? 'on' : ''" @click="pick(a.id)">{{ a.title }}</button>
      </nav>
    </header>

    <div class="layout">
      <aside class="toc">
        <input class="toc-q" type="search" v-model="q" placeholder="このページ内を検索…">
        <p class="toc-h">目次</p>
        <button class="toc-i" v-for="(s, i) in shown()" :class="active() === s.id ? 'on' : ''" @click="goto(s.id)">{{ i + 1 }}. {{ s.h }}</button>
        <p class="toc-empty" v-if="!shown().length">一致なし</p>
      </aside>

      <article class="doc">
        <h1 class="title">{{ cur().title }}</h1>
        <p class="meta">最終更新 {{ cur().updated }} ・ <span class="tag" v-for="t in cur().tags" :key="t">#{{ t }}</span></p>
        <section class="sec" v-for="(s, i) in shown()" :id="s.id">
          <h2 class="sh" @click="toggle(s.id)"><span class="caret">{{ isOpen(s.id) ? '▾' : '▸' }}</span> {{ i + 1 }}. {{ s.h }}</h2>
          <p class="stext" v-if="isOpen(s.id)">{{ s.body }}</p>
        </section>
        <p class="doc-empty" v-if="!shown().length">「{{ q() }}」に一致する見出し・本文はありません。</p>
      </article>
    </div>
  </div>
</template>

<script>
import { ARTICLES } from './articles.js';

export default {
  name: 'App',
  setup() {
    const route = useRoute();
    const articles = ARTICLES;
    const curId = () => (route().startsWith('/page/') ? route().replace('/page/', '') : articles[0].id);
    const cur = computed(() => articles.find((a) => a.id === curId()) || articles[0]);
    const q = signal('');                                        // ページ内検索
    const shown = computed(() => { const t = q().trim().toLowerCase(); return cur().sections.filter((s) => !t || (s.h + ' ' + s.body).toLowerCase().includes(t)); });
    const closed = signal({});                                   // { [sectionId]: true } = 折りたたみ中
    const isOpen = (id) => !closed()[id];
    const toggle = (id) => closed.update((m) => ({ ...m, [id]: !m[id] }));
    const active = signal('');                                   // 表示中の見出し（スクロール連動）
    const pick = (id) => { navigate('/page/' + id); active.set(''); };
    const goto = (id) => { const el = typeof document !== 'undefined' && document.getElementById(id); if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' }); };

    // スクロール連動の目次ハイライト（IntersectionObserver・onMount＝SSR 安全・記事切替で貼り直し）。
    const mounted = signal(false);
    let io = null;
    onMount(() => { mounted.set(true); onCleanup(() => io && io.disconnect()); });
    effect(() => {
      cur(); shown();                                            // 記事・絞り込みが変わったら貼り直す依存
      if (!mounted() || typeof IntersectionObserver === 'undefined') return;
      requestAnimationFrame(() => {
        if (io) io.disconnect();
        io = new IntersectionObserver((es) => { for (const e of es) if (e.isIntersecting) active.set(e.target.id); }, { rootMargin: '0px 0px -70% 0px' });
        document.querySelectorAll('.sec').forEach((s) => io.observe(s));
      });
    });

    return { articles, cur, q, shown, isOpen, toggle, active, pick, goto };
  },
};
</script>

<style lang="scss">
$fg: oklch(24% 0.02 260);
$accent: oklch(52% 0.16 250);
$script: "Dancing Script", "Great Vibes", "Snell Roundhand", "Segoe Script", "Brush Script MT", cursive;
.wiki { font-family: system-ui, "Noto Sans JP", sans-serif; color: $fg; max-width: 66rem; margin: 0 auto; padding: 0 1rem 4rem; }
.top { display: flex; align-items: center; gap: .5rem 1rem; flex-wrap: wrap; padding: 1rem 0; border-bottom: 1px solid #eef; }
.brand { font-family: $script; font-size: 2rem; font-weight: 700; line-height: 1; border: 0; background: none; cursor: pointer; padding: 0; min-width: 0; max-width: 100%; overflow-wrap: anywhere; color: $accent; }
.tabs { display: flex; flex-wrap: wrap; gap: .3rem; margin-left: auto; }
.tab { font: inherit; font-size: .88rem; border: 1px solid #dde; background: #fff; border-radius: 999px; padding: .25rem .8rem; cursor: pointer; }
.tab.on { background: $accent; border-color: transparent; color: #fff; }

.layout { display: grid; grid-template-columns: 1fr; gap: 1.4rem; margin-top: 1.2rem; }
@media (min-width: 48rem) { .layout { grid-template-columns: 13rem 1fr; gap: 2rem; } .toc { position: sticky; top: 1rem; align-self: start; } }

.toc-q { width: 100%; font: inherit; font-size: .85rem; padding: .35rem .55rem; border: 1px solid #dde; border-radius: 8px; margin-bottom: .7rem; }
.toc-empty, .doc-empty { color: #889; font-size: .85rem; }
.toc-h { font-size: .8rem; color: #889; margin: 0 0 .4rem; letter-spacing: .05em; }
.toc-i { display: block; width: 100%; text-align: left; font: inherit; font-size: .9rem; border: 0; border-left: 2px solid transparent; background: none; cursor: pointer; padding: .3rem .6rem; color: #556; border-radius: 0 6px 6px 0; }
.toc-i:hover { background: #f4f6ff; }
.toc-i.on { border-left-color: $accent; color: $accent; background: #f4f6ff; font-weight: 600; }

.title { font-family: $script; font-weight: 700; font-size: 2.8rem; line-height: 1.1; margin: 0 0 .3rem; color: $fg; }
.meta { color: #889; font-size: .85rem; margin: 0 0 1.5rem; }
.tag { color: $accent; margin-right: .4rem; }
.sec { scroll-margin-top: 1rem; border-top: 1px solid #f0f2f8; padding: 1rem 0; }
.sh { font-size: 1.15rem; margin: 0; cursor: pointer; user-select: none; }
.caret { color: #aab; font-size: .9rem; }
.stext { line-height: 1.85; color: oklch(34% 0.02 260); margin: .6rem 0 0; }
</style>
